# Fastfile for Nuxbe Mobile

default_platform(:ios)

platform :ios do
  desc "Upload IPA to TestFlight"
  lane :upload do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    ipa_path = ENV['IPA_PATH'] || Dir['./build/**/*.ipa'].map { |f| File.expand_path(f) }.first
    UI.user_error!("No IPA file found") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit existing IPA to the App Store (optionally for review)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    # SKIP_BINARY submits the already uploaded build of this version
    # (e.g. when retrying after a failed review submission)
    skip_binary = ENV['SKIP_BINARY'] == 'true'

    ipa_path = nil
    unless skip_binary
      ipa_path = ENV['IPA_PATH'] || Dir['./build/**/*.ipa'].map { |f| File.expand_path(f) }.first
      UI.user_error!("No IPA file found") unless ipa_path
    end

    app_version = (ENV['APP_VERSION'] || '').delete_prefix('v').sub(/-.*/, '')

    # Upload metadata and release notes when the repo contains them
    has_metadata = File.directory?(File.expand_path("metadata", __dir__))

    deliver(
      api_key: api_key,
      app_identifier: ENV['APP_IDENTIFIER'] || "com.teamnifty.nuxbe",
      ipa: ipa_path,
      skip_binary_upload: skip_binary,
      app_version: app_version.empty? ? nil : app_version,
      submit_for_review: ENV['SUBMIT_FOR_REVIEW'] == 'true',
      automatic_release: ENV['AUTOMATIC_RELEASE'] == 'true',
      skip_screenshots: true,
      skip_metadata: !has_metadata,
      run_precheck_before_submit: true,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Download App Store metadata into the repo"
  lane :download_metadata do
    require 'json'

    # download_metadata is a deliver CLI subcommand, not an action option
    key_file = File.expand_path("../asc_api_key.json")
    File.write(key_file, {
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key: File.read(File.expand_path(ENV['ASC_KEY_PATH'])),
    }.to_json)

    begin
      sh(
        "cd .. && bundle exec fastlane deliver download_metadata " \
        "--api_key_path #{key_file.shellescape} " \
        "--app_identifier #{(ENV['APP_IDENTIFIER'] || 'com.teamnifty.nuxbe').shellescape} " \
        "--metadata_path ./fastlane/metadata " \
        "--force"
      )
    ensure
      File.delete(key_file) if File.exist?(key_file)
    end
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    deliver(
      api_key: api_key,
      app_identifier: ENV['APP_IDENTIFIER'] || "com.teamnifty.nuxbe",
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Build development IPA"
  lane :build_development do
    setup_ci if ENV['CI']

    app_identifier = ENV['APP_IDENTIFIER'] || "com.teamnifty.nuxbe"
    dev_profile = ENV['DEV_PROVISIONING_PROFILE_SPECIFIER']

    export_opts = {
      method: "development",
      signingStyle: "manual"
    }

    if dev_profile && !dev_profile.empty?
      export_opts[:provisioningProfiles] = {
        app_identifier => dev_profile
      }
    end

    xcargs = []
    xcargs << "DEVELOPMENT_TEAM=YS428GD6FU"
    xcargs << "CODE_SIGN_STYLE=Manual"
    if dev_profile && !dev_profile.empty?
      xcargs << "PROVISIONING_PROFILE_SPECIFIER='#{dev_profile}'"
    end

    gym(
      scheme: "App",
      project: "App.xcodeproj",
      configuration: "Debug",
      export_method: "development",
      clean: true,
      output_directory: "./build",
      output_name: "nuxbe-mobile-dev.ipa",
      export_options: export_opts,
      xcargs: xcargs.join(' ')
    )
  end

  desc "Download provisioning profiles"
  lane :sync_profiles do
    match(type: "appstore", readonly: true)
    match(type: "development", readonly: true)
  end

  desc "Revoke a single certificate by id (use only for confirmed orphans)"
  lane :revoke_certificate do |options|
    cert_id = options[:certificate_id] || ENV['CERTIFICATE_ID']
    UI.user_error!("Pass certificate_id - this is intentionally explicit, certificates are shared across the whole Apple team") if cert_id.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    Spaceship::ConnectAPI.token = token

    cert = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == cert_id }
    UI.user_error!("Certificate #{cert_id} not found") unless cert

    UI.important("Revoking certificate #{cert.id} (#{cert.certificate_type}, expires #{cert.expiration_date})")
    Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
  end

  desc "Create or renew certificates and profiles in the match repo (CI bootstrap)"
  lane :bootstrap_signing do
    setup_ci if ENV['CI']

    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    # Prerequisite (one-time, manual): the App Group cannot be managed with
    # an App Store Connect API key - fastlane produce uses the legacy portal
    # API with an Apple ID session for groups. In the developer portal:
    #   1. Identifiers > App IDs: register com.teamnifty.nuxbe.share
    #   2. Identifiers > App Groups: register group.com.teamnifty.nuxbe
    #   3. Enable the App Groups capability with that group on BOTH app ids
    UI.important("Requires com.teamnifty.nuxbe.share + group.com.teamnifty.nuxbe configured in the developer portal (see comment above)")

    # force: profiles must be regenerated when entitlements change (app group)
    match(type: "appstore", readonly: false, force: true, api_key: api_key)
    match(type: "development", readonly: false, force: true, api_key: api_key)
  end

  desc "Build production IPA signed via match"
  lane :build_with_match do
    setup_ci if ENV['CI']

    if ENV['APP_VERSION'] && !ENV['APP_VERSION'].empty?
      increment_version_number(
        version_number: ENV['APP_VERSION'],
        xcodeproj: "App.xcodeproj"
      )
    end

    if ENV['BUILD_NUMBER'] && !ENV['BUILD_NUMBER'].empty?
      increment_build_number(
        build_number: ENV['BUILD_NUMBER'],
        xcodeproj: "App.xcodeproj"
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: File.expand_path(ENV['ASC_KEY_PATH']),
    )

    match(type: "appstore", readonly: true, api_key: api_key)

    profile_mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    # Per-target signing: a global PROVISIONING_PROFILE_SPECIFIER would also
    # apply to the share extension target and break its signature.
    {
      "App" => "com.teamnifty.nuxbe",
      "NuxbeShare" => "com.teamnifty.nuxbe.share",
    }.each do |target, bundle_id|
      update_code_signing_settings(
        path: "App.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: "YS428GD6FU",
        code_sign_identity: "Apple Distribution",
        profile_name: profile_mapping[bundle_id],
      )
    end

    gym(
      scheme: "App",
      project: "App.xcodeproj",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "nuxbe-mobile.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: profile_mapping,
      },
    )
  end

  desc "Register new device"
  lane :add_device do |options|
    register_devices(devices: { options[:name] => options[:udid] })
    match(type: "development", force_for_new_devices: true)
  end
end
