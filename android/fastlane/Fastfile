# Fastfile for the Nuxbe Mobile Android app

default_platform(:android)

platform :android do
  desc "Upload AAB to Google Play (track and release status via PLAY_TRACK / RELEASE_STATUS)"
  lane :upload do
    aab_path = ENV['AAB_PATH']
    UI.user_error!("No AAB file found - set AAB_PATH") unless aab_path

    # Upload changelogs when the repo contains Play metadata
    has_metadata = File.directory?(File.expand_path("metadata/android", __dir__))

    upload_to_play_store(
      aab: aab_path,
      track: ENV['PLAY_TRACK'] || "internal",
      release_status: ENV['RELEASE_STATUS'] || "draft",
      json_key: ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH'],
      package_name: "com.teamnifty.nuxbe",
      metadata_path: has_metadata ? "./fastlane/metadata/android" : nil,
      skip_upload_metadata: true,
      skip_upload_changelogs: !has_metadata,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest internal build to production without re-uploading"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: ENV['RELEASE_STATUS'] || "completed",
      json_key: ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH'],
      package_name: "com.teamnifty.nuxbe",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload screenshots to Google Play"
  lane :upload_screenshots do
    upload_to_play_store(
      package_name: "com.teamnifty.nuxbe",
      json_key: ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH'],
      metadata_path: ENV['METADATA_PATH'] || "./fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
    )
  end

  desc "Report which version codes are still active on each Play track"
  lane :play_status do
    require 'google/apis/androidpublisher_v3'
    require 'googleauth'

    json_key = ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH']
    UI.user_error!("Set PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH") if json_key.to_s.empty?

    package_name = "com.teamnifty.nuxbe"

    # Version codes are minutes since the epoch (see the release workflow), so
    # they sort chronologically. targetSdkVersion moved 35 -> 36 on 2026-06-12,
    # and this is the code that boundary falls on.
    target_sdk_36_since = 29_687_760

    # A draft release sits on a track without ever reaching a device, so it is
    # not what Google's target API warning is about. The fastlane helpers report
    # version codes without their status and cannot tell the two apart, which is
    # why this talks to the API directly.
    serving_states = %w[completed inProgress halted]

    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(json_key),
      scope: 'https://www.googleapis.com/auth/androidpublisher'
    )

    edit = service.insert_edit(package_name)
    stale = []

    begin
      (service.list_edit_tracks(package_name, edit.id).tracks || []).each do |track|
        releases = track.releases || []

        if releases.empty?
          UI.message("#{track.track}: no release")
          next
        end

        releases.each do |release|
          codes = (release.version_codes || []).map(&:to_i)
          label = "#{track.track}: #{codes.join(', ')} (#{release.name}) status=#{release.status}"

          unless serving_states.include?(release.status)
            UI.message("#{label} - not served, ignored")
            next
          end

          UI.message(label)

          old = codes.select { |c| c < target_sdk_36_since }
          if old.empty?
            UI.success("  all on targetSdk 36")
          else
            stale.concat(old)
            UI.important("  targetSdk 35 still served here: #{old.join(', ')}")
          end
        end
      end
    ensure
      service.delete_edit(package_name, edit.id)
    end

    if stale.empty?
      UI.success("No track serves a targetSdk 35 release.")
    else
      UI.important("Deactivate or supersede: #{stale.uniq.join(', ')} - they are what Google is warning about.")
    end
  end

  desc "Download Play Store metadata into the repo"
  lane :download_metadata do
    sh("cd .. && bundle exec fastlane supply init --json_key #{ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON_PATH']} --package_name com.teamnifty.nuxbe --metadata_path ./fastlane/metadata/android")
  end
end
